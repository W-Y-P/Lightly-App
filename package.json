{
  "name": "fat-loss-app-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/miniprogram"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "npm run dev -w apps/api",
    "dev:miniprogram": "npm run dev:weapp -w apps/miniprogram",
    "dev:miniprogram:h5": "npm run dev:h5:node20 -w apps/miniprogram",
    "build": "tsc --noEmit && vite build",
    "build:api": "npm run build -w apps/api",
    "build:miniprogram": "npm run build:weapp -w apps/miniprogram",
    "build:miniprogram:node20": "cd apps/miniprogram && npx -p node@20 node ../../node_modules/.bin/taro build --type weapp",
    "build:miniprogram:h5": "npm run build:h5:node20 -w apps/miniprogram",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.4",
    "@swc/core": "^1.3.96",
    "@swc/core-darwin-arm64": "^1.3.96",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.60.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^4.5.14"
  }
}
